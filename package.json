{
  "name": "sidhel-chor-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "node scripts/vitest.mjs run",
    "smoke": "node tests/smoke/smoke.mjs",
    "check": "tsc -b && eslint . && node scripts/vitest.mjs run",
    "smoke:phase2": "node tests/smoke/phase2.mjs",
    "smoke:phase3": "node tests/smoke/phase3-full.mjs",
    "smoke:phase3-outcomes": "node tests/smoke/phase3-outcomes.mjs",
    "smoke:phase3-touch": "node tests/smoke/phase3-touch.mjs",
    "assets:placeholder": "node scripts/assets/build-placeholder-thief.mjs && node scripts/assets/optimize-glb.mjs public/assets/models/characters/thief_placeholder.glb && node scripts/assets/validate-glb.mjs",
    "assets:optimize": "node scripts/assets/optimize-glb.mjs",
    "validate:glb": "node scripts/assets/validate-glb.mjs",
    "tour": "node tests/smoke/visual-tour.mjs",
    "shoot:glb": "node tests/visual/shoot-glb.mjs",
    "smoke:premium": "node tests/smoke/premium.mjs",
    "assets:thief": "node scripts/assets/build-thief.mjs",
    "perf:thief": "node tests/visual/perf-thief.mjs",
    "voice:manifest": "node scripts/assets/voice-manifest.mjs",
    "voice:script": "node scripts/assets/voice-manifest.mjs --script",
    "smoke:phase4b": "node tests/smoke/phase4b.mjs",
    "smoke:phase4b-touch": "node tests/smoke/phase4b-touch.mjs",
    "smoke:multinight": "node tests/smoke/multinight.mjs",
    "perf:npc": "node tests/visual/perf-npc.mjs"
  },
  "dependencies": {
    "@fontsource/hind-siliguri": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/rapier": "^2.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "4.2.1",
    "@gltf-transform/extensions": "4.2.1",
    "@gltf-transform/functions": "4.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
